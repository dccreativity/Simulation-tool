<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicitly opaque: on some firmware Theme.DeviceDefault comes out translucent, and the TV app keeps
         running (and showing its last HDMI picture) underneath Home. -->
    <style name="Home" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
