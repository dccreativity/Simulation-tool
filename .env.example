# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.
#
# Both values are PUBLIC by design (shipped to the browser). Row Level Security
# in Supabase protects each user's data. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
